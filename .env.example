# Security Salt (required in production)
SALT="your-super-secret-salt-change-me-in-production"

# Firestore project (required for Cloud Run / Vercel)
# GOOGLE_CLOUD_PROJECT=techguys-interne
# FIRESTORE_COLLECTION=shares

# Cloud Run: leave this unset — uses Application Default Credentials automatically.
# Vercel / local-with-Firestore: paste the service account JSON on one line.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Local development: uses file storage by default (.secure-shares/)
# USE_FILE_STORAGE=true

# Firestore emulator (optional local testing)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_CLOUD_PROJECT=demo-project
