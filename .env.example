# Security Salt (required in production)
SALT="your-super-secret-salt-change-me-in-production"

# Firestore (production on Cloud Run — uses Application Default Credentials automatically)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=shares

# Local development: uses file storage by default (.secure-shares/)
# USE_FILE_STORAGE=true

# Firestore emulator (optional local testing)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_CLOUD_PROJECT=demo-project
